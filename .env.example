CONGRESS_API_KEY=your_api_data_gov_key_here
GEMINI_API_KEY=your_google_ai_studio_key_here
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_database_scoped_token_here
CRON_SECRET=any_random_32_byte_hex_string
FMP_API_KEY=             # https://site.financialmodelingprep.com/developer/docs free tier, 250/day
FEC_API_KEY=              # api.data.gov key, member fundraising (FEC). Shares the 60 req/hr budget with CONGRESS_API_KEY
FRED_API_KEY=             # St. Louis Fed JSON API, free; markets tape EOD + monthly symbols. Vercel Production scope
LDA_API_KEY=              # lda.gov lobbying disclosure, sent as `Authorization: Token <key>`. Production + Preview
AUTH_SECRET=              # signs the NextAuth v5 JWT/session cookie. Production only
AUTH_GITHUB_ID=           # GitHub OAuth app client id (Auth.js reads it implicitly). Production only
AUTH_GITHUB_SECRET=       # GitHub OAuth app client secret (Auth.js reads it implicitly). Production only
REVALIDATE_URL=http://localhost:3000/api/revalidate   # POST target for backfill scripts flushing a cache tag
